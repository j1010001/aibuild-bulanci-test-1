{
  "name": "browser-party-shooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.core.json && tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p server/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tests/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot": "tsx scripts/bot.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.169.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
